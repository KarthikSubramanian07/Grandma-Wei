{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["bun", "@cloudflare/workers-types"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["packages/*/src/**/*.ts"]
}
